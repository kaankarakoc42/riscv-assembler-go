// =============================================================================
// tang_nano_9k.cst - Tang Nano 9K pin constraints
// Proje 3: UART Bootloader
// =============================================================================

// -----------------------------------------------------------------------------
// Saat ve reset
// -----------------------------------------------------------------------------
IO_LOC "sys_clk"   52;
IO_PORT "sys_clk"  IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "sys_rst_n" 4;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// -----------------------------------------------------------------------------
// 6 LED (active-low)
// -----------------------------------------------------------------------------
IO_LOC "led[0]"  10;
IO_LOC "led[1]"  11;
IO_LOC "led[2]"  13;
IO_LOC "led[3]"  14;
IO_LOC "led[4]"  15;
IO_LOC "led[5]"  16;
IO_PORT "led[0]" IO_TYPE=LVCMOS33;
IO_PORT "led[1]" IO_TYPE=LVCMOS33;
IO_PORT "led[2]" IO_TYPE=LVCMOS33;
IO_PORT "led[3]" IO_TYPE=LVCMOS33;
IO_PORT "led[4]" IO_TYPE=LVCMOS33;
IO_PORT "led[5]" IO_TYPE=LVCMOS33;

// -----------------------------------------------------------------------------
// UART (BL702 USB-UART koprusune)
// -----------------------------------------------------------------------------
// FPGA acisindan:
//   uart_rx (input)  <- BL702_TX -> PIN 17
//   uart_tx (output) -> BL702_RX -> PIN 18
//
// Yani PC'den FPGA'ye veri pin 17'den geliyor, FPGA'den PC'ye pin 18'den.

IO_LOC "uart_rx" 17;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "uart_tx" 18;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
